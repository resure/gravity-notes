{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main", "ws-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "dialog:default",
    "updater:default",
    "process:default"
  ]
}
