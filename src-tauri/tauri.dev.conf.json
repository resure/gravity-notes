{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sol Dev",
  "identifier": "net.resure.sol.dev",
  "app": {
    "windows": [
      {
        "title": "Sol Dev",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1100,
        "height": 740,
        "minWidth": 300,
        "minHeight": 380,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons-dev/32x32.png",
      "icons-dev/128x128.png",
      "icons-dev/128x128@2x.png",
      "icons-dev/icon.icns",
      "icons-dev/icon.ico"
    ]
  }
}
